# Environment Configuration for AI Incident Investigation Platform

# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Security
SECRET_KEY=incident-investigator-super-secret-key-32charsmin!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=incident_agent_db

# OpenAI API Configuration
# Used for:
# 1. Embeddings: text-embedding-3-small (1536 dimensions)
# 2. Reasoning & Root Cause Analysis: gpt-4o / gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
